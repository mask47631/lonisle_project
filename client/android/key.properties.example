# 复制为 key.properties 并填写真实值（key.properties 与 keystore 文件均已 gitignore，不得入库）
# 生成 keystore：
#   keytool -genkey -v -keystore ~/lonisle-release-key.jks -keyalg RSA \
#     -keysize 2048 -validity 36500 -alias lonisle-release
storeFile=/绝对路径/lonisle-release-key.jks
storePassword=你的keystore密码
keyAlias=lonisle-release
keyPassword=你的key密码
